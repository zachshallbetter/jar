{
 "about": "The 5W eval (#1399 P3/P4; spec §10.1) over household.json. Each case asks situation(query, viewer) and checks slots. A slot expects: a value set ('is' = exactly these; 'has' = at least these), 'unknown' (no supported answer; never a guess), or 'contested' (both chains listed). 'lacks' lists ids/strings that must appear nowhere in the bundle, for that viewer. 'via' lists items the why-chain must cite. 'rung' is the weakest rung the answer may state. now = household.json now.",
 "slots": ["who", "what", "where", "when", "why"],
 "cases": [
  {"id": "plan-1", "story": "plan in texts", "as": ["p_alex", "admin"], "q": "What are we doing Saturday morning?",
   "expect": {"what": {"has": ["Pine Park"]}, "where": {"is": ["pl-pine-park"]}, "when": {"is": ["2026-10-10T10:00"]},
              "who": {"is": ["p_alex", "p_robin", "p_jordan", "p_ava", "p_leo"]}, "via": ["dev-text-plan-1", "dev-text-plan-2"], "rung": "attributed"}},
  {"id": "plan-2", "story": "plan in texts", "as": ["p_alex", "admin"], "q": "Who's coming to the park?",
   "expect": {"who": {"is": ["p_alex", "p_robin", "p_jordan", "p_ava", "p_leo"]}, "via": ["dev-text-plan-2"]}},
  {"id": "plan-3", "story": "plan in texts", "as": ["p_alex", "admin"], "q": "Where exactly do we meet Robin?",
   "expect": {"where": {"is": ["pl-pine-park"]}, "what": {"has": ["playground entrance"]}, "via": ["dev-text-plan-3", "chat-alex-1"],
              "note": "Alex's own chat statement agrees with the text; a statement outranks inference"}},
  {"id": "plan-4", "story": "plan in texts", "as": ["p_alex", "admin"], "q": "Why do you think Leo is coming?",
   "expect": {"who": {"has": ["p_leo"]}, "via": ["dev-text-plan-2"], "rung": "attributed"}},
  {"id": "plan-5", "story": "plan in texts", "as": ["p_ava", "kid"], "q": "Are we going to the park Saturday?",
   "expect": {"what": "unknown", "lacks": ["dev-text-plan-1", "dev-text-plan-2", "dev-text-plan-3"],
              "note": "the plan lives in Alex's private texts; until it's added to a shared calendar a kid gets unknown, not a leak"}},
  {"id": "plan-6", "story": "plan in texts", "as": ["p_robin", "adult"], "q": "What did Alex say about Saturday?",
   "expect": {"what": "unknown", "lacks": ["dev-text-plan-2"],
              "note": "the texts are Alex's items on Alex's device; Robin's own copy isn't in the fixture"}},
  {"id": "plan-proactive", "story": "plan in texts", "as": ["p_alex", "admin"], "q": "@proactive",
   "expect": {"proposals": {"count": 1, "is": ["a1b2c3d4e5f60718"]}, "note": "the Mac already proposed it: the engine must not raise a second card"}},

  {"id": "meet-1", "story": "meeting", "as": ["p_alex", "admin"], "q": "What did the club board decide?",
   "expect": {"what": {"has": ["fall cleanup", "Dues rise to $40", "volunteer sign-up"]}, "via": ["cx-meeting-club-1"], "rung": "observed"}},
  {"id": "meet-2", "story": "meeting", "as": ["p_alex", "admin"], "q": "When and where is the fall cleanup?",
   "expect": {"when": {"is": ["2026-10-24T09:00"]}, "where": {"is": ["pl-pine-park"]}, "via": ["cx-meeting-club-1", "cx-mail-club-2"]}},
  {"id": "meet-3", "story": "meeting", "as": ["p_alex", "admin"], "q": "What am I on the hook for from the board meeting?",
   "expect": {"what": {"has": ["volunteer sign-up"]}, "who": {"is": ["p_alex"]}, "via": ["cx-meeting-club-1"]}},
  {"id": "meet-4", "story": "meeting", "as": ["p_alex", "admin"], "q": "When's the next board meeting?",
   "expect": {"when": {"is": ["2026-11-12T19:00"]}, "where": "unknown", "via": ["cx-meeting-club-1"]}},
  {"id": "meet-5", "story": "meeting", "as": ["p_jordan", "adult"], "q": "What did the club decide about dues?",
   "expect": {"what": "unknown", "lacks": ["cx-meeting-club-1", "cx-mail-club-2", "$40"]}},

  {"id": "trade-1", "story": "trade-in", "as": ["p_alex", "admin"], "q": "What's happening with the Harbor trade-in?",
   "expect": {"what": {"has": ["received", "$180", "pending"]}, "who": {"is": ["household:harbor-mobile"]}, "via": ["dev-text-trade-1", "cx-mail-trade-2"], "rung": "observed"}},
  {"id": "trade-2", "story": "trade-in", "as": ["p_alex", "admin"], "q": "Is the Harbor bill related to the trade-in?",
   "expect": {"what": {"has": ["not related"]}, "lacks_link": [["cx-mail-trade-2", "cx-mail-bill-3"]],
              "note": "Alex said they're unrelated; a rejected edge never comes back"}},
  {"id": "trade-3", "story": "trade-in", "as": ["p_alex", "admin"], "q": "Which task is waiting on Harbor Mobile?",
   "expect": {"what": {"has": ["trade-in credit"]}, "via": ["task-tradein"]}},
  {"id": "trade-4", "story": "trade-in", "as": ["p_robin", "adult"], "q": "Did the Harbor trade-in go through?",
   "expect": {"what": "unknown", "lacks": ["cx-mail-trade-2", "dev-text-trade-1", "task-tradein", "$180"]}},

  {"id": "bill-1", "story": "bills", "as": ["p_alex", "admin"], "q": "Is anything waiting on me?",
   "expect": {"what": {"has": ["Pine Water", "$48.20", "2026-10-20"]}, "via": ["cx-mail-bill-4"], "lacks": ["cx-mail-bill-1"],
              "note": "Pine Water (due 2026-10-20) is waiting; Harbor (paid by Alex's text 10-08) and Lakeside (overdue → paid 09-24) are not"}},
  {"id": "bill-2", "story": "bills", "as": ["p_alex", "admin"], "q": "Did I pay Lakeside?",
   "expect": {"what": {"has": ["paid", "2026-09-24"]}, "via": ["cx-mail-bill-1", "cx-mail-bill-2"], "rung": "observed"}},
  {"id": "bill-3", "story": "bills", "as": ["p_alex", "admin"], "q": "When is the Harbor bill due?",
   "expect": {"when": {"is": ["2026-10-14"]}, "via": ["cx-mail-bill-3"]}},
  {"id": "bill-4", "story": "bills", "as": ["p_ava", "kid"], "q": "Do we owe anyone money?",
   "expect": {"what": "unknown", "lacks": ["cx-mail-bill-3", "$62.50", "$95"]}},

  {"id": "dent-1", "story": "contested", "as": ["p_alex", "admin"], "q": "What time is Ava's dentist appointment?",
   "expect": {"when": "contested", "via": ["cx-calendar-dentist", "cx-mail-dentist"],
              "note": "calendar 15:00 vs the dentist's newer mail 16:00: both chains, one ask; the newer source may be preferred but must be shown as a change"}},
  {"id": "dent-2", "story": "contested", "as": ["p_robin", "adult"], "q": "When is Ava's dentist?",
   "expect": {"when": {"is": ["2026-10-13T15:00"]}, "lacks": ["cx-mail-dentist", "16:00"],
              "note": "Robin can't see Alex's private mail, so for Robin it isn't contested: only the shared calendar"}},
  {"id": "dent-3", "story": "contested", "as": ["p_ava", "kid"], "q": "When do I go to the dentist?",
   "expect": {"when": {"is": ["2026-10-13T15:00"]}, "where": {"is": ["pl-summit"]}, "lacks": ["cx-mail-dentist"]}},

  {"id": "unk-1", "story": "unknown place", "as": ["p_jordan", "adult"], "q": "Where is Leo's practice tomorrow?",
   "expect": {"when": {"is": ["2026-10-11T17:30"]}, "where": "unknown", "via": ["cx-calendar-practice"],
              "note": "no location and no world place: unknown, never a guess like the park"}},
  {"id": "unk-2", "story": "unknown place", "as": ["p_leo", "kid"], "q": "When's my soccer practice?",
   "expect": {"when": {"is": ["2026-10-11T17:30"]}, "who": {"has": ["p_leo"]}}},

  {"id": "priv-1", "story": "privacy", "as": ["p_alex", "admin"], "q": "Is anything planned for the 18th?",
   "expect": {"what": "unknown", "lacks": ["dev-text-surprise", "surprise"],
              "note": "Robin's private text about Alex's surprise party never reaches Alex, admin or not"}},
  {"id": "priv-2", "story": "privacy", "as": ["p_robin", "adult"], "q": "What's planned for the 18th?",
   "expect": {"what": {"has": ["surprise party"]}, "where": {"is": ["pl-clubhouse"]}, "via": ["dev-text-surprise"]}},
  {"id": "priv-3", "story": "privacy", "as": ["screen", "screen"], "q": "What's happening this week?",
   "expect": {"lacks": ["dev-text-plan-1", "cx-meeting-club-1", "dev-text-surprise", "cx-mail-dentist", "cx-note-health", "cx-calendar-yoga", "cx-calendar-bookclub"],
              "what": {"has": ["Ava dentist", "Leo soccer practice"]}}},
  {"id": "priv-4", "story": "fence", "as": ["p_jordan", "adult"], "q": "Does Ava have an allergy plan?",
   "expect": {"what": "unknown", "lacks": ["cx-note-health", "inhaler"], "note": "audience adults, but fenced from Jordan"}},
  {"id": "priv-5", "story": "fence", "as": ["p_robin", "adult"], "q": "What's Ava's allergy plan?",
   "expect": {"what": {"has": ["inhaler"]}, "via": ["cx-note-health"]}},
  {"id": "priv-6", "story": "same name", "as": ["p_alex", "admin"], "q": "Who is Morgan Reyes?",
   "expect": {"who": {"is": ["p_alex:morgan-reyes-coach"]}, "what": {"has": ["coach"]}, "lacks": ["nurse", "p_robin:morgan-reyes-colleague"],
              "note": "same name, different people: never merged, and Robin's contact never shows to Alex"}},
  {"id": "priv-7", "story": "same name", "as": ["p_robin", "adult"], "q": "Who is Morgan Reyes?",
   "expect": {"who": {"is": ["p_robin:morgan-reyes-colleague"]}, "what": {"has": ["nurse"]}, "lacks": ["coach"]}},

  {"id": "where-1", "story": "where now", "as": ["p_alex", "admin"], "q": "Where's Ava right now?",
   "expect": {"where": {"is": ["pl-cedar"]}, "when": {"is": ["2026-10-10T15:20"]}, "via": ["pe-ava-1"], "note": "a parent sees their kid's place"}},
  {"id": "where-2", "story": "where now", "as": ["p_jordan", "adult"], "q": "Where's Ava right now?",
   "expect": {"where": "unknown", "lacks": ["pe-ava-1"], "note": "Jordan isn't Ava's parent"}},
  {"id": "where-3", "story": "where now", "as": ["p_robin", "adult"], "q": "Where's Alex?",
   "expect": {"where": "unknown", "lacks": ["pe-alex-1"], "note": "an adult's place events are their own"}},
  {"id": "where-4", "story": "where now", "as": ["p_alex", "admin"], "q": "Who's picking Ava up today?",
   "expect": {"who": {"is": ["p_robin"]}, "when": {"is": ["2026-10-10T15:15"]}, "where": {"is": ["pl-cedar"]}, "via": ["cx-calendar-pickup"],
              "note": "the calendar location '40 Cedar Ave' resolves to the school place by alias"}},

  {"id": "place-1", "story": "places", "as": ["p_robin", "adult"], "q": "Where do I do yoga?",
   "expect": {"where": {"is": ["pl-cand-willow"]}, "note": "seen 3 times: a place for Robin"}},
  {"id": "place-2", "story": "places", "as": ["p_jordan", "adult"], "q": "Where is book club?",
   "expect": {"where": {"has": ["Ember Café"]}, "rung": "observed",
              "note": "the calendar says it; the candidate place is not promoted (seen once), so the answer cites the item's text, not a place node"}},

  {"id": "rel-1", "story": "relations", "as": ["p_alex", "admin"], "q": "Who are Leo's parents?",
   "expect": {"who": {"is": ["p_jordan"]}, "rung": "observed"}},
  {"id": "rel-2", "story": "relations", "as": ["p_ava", "kid"], "q": "What's the guest wifi called?",
   "expect": {"what": {"has": ["Quarry-Guest"]}, "via": ["cx-note-wifi"]}},
  {"id": "rel-3", "story": "merge", "as": ["p_alex", "admin"], "q": "Is Harbor Mobile Billing the same as Harbor Mobile?",
   "expect": {"who": {"is": ["household:harbor-mobile"]}, "what": {"has": ["same"]}, "note": "alias plus the shared domain: same_as"}}
 ]
}
