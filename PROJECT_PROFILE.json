    "inference": "llama.cpp / unified-memory / hybrid-cloud-fallback"
  },
  "interfaces": {
    "api_port": 7770,
    "onboarding_route": "/setup",
    "client": "jellybean",
    "discovery": "mdns (_titan._tcp.local.)"
  },
  "authority_chain": [
    "PROJECT_INTENT.md",
    "AUTHORITY.md",
    "docs/architecture.md",
    "src/jar/"
  ]
}

